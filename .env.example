# Meta-Trustguard 환경변수 예시. `cp .env.example .env` 후 실제 값으로 채우고 chmod 600 .env.
# 비어 있는 외부 연동(ICS / IPCC / MQTT)은 해당 HOST 를 비워두면 자동 비활성(no-op)됩니다.

# ─── PostgreSQL (앱 메인 DB) ───────────────────────────────────────────────
POSTGRES_USER=qa_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qa_dashboard

# 신규 사용자 추가 / 비번 재설정 시 부여되는 초기 비밀번호.
# 사용자는 첫 로그인 시 직접 변경하도록 강제됨(must_change_password).
INITIAL_USER_PASSWORD=change-me

# ─── ICS SSO — 운영 MariaDB 읽기전용 계정 (선택) ───────────────────────────
# ICS_DB_HOST 가 비면 SSO 비활성. ?userId=<id> 메뉴 진입 시 자동 로그인에 사용.
ICS_DB_HOST=
ICS_DB_PORT=3306
ICS_DB_USER=
ICS_DB_PW=
ICS_DB_NAME=
# ICS SSO 사용자가 합류할 기본 조직 id (조직 PK).
ICS_SSO_DEFAULT_ORG_ID=

# ─── IPCC 포기호/응답률(call_logs) — autossh 사이드카 'xhub-tunnel' 경유 (선택) ─
# qa-ai-api 는 xhub-tunnel:13306 으로 접속. IPCC_DB_HOST 비면 no-op.
IPCC_DB_HOST=
IPCC_DB_PORT=3306
IPCC_DB_USER=
IPCC_DB_PASSWORD=
IPCC_DB_NAME=
# autossh 사이드카(xhub-tunnel) SSH 접속 — 비번접속. IPCC_SSH_HOST 비면 터널 대기.
IPCC_SSH_HOST=
IPCC_SSH_PORT=22
IPCC_SSH_USER=
IPCC_SSH_PASS=

# ─── AICC MQTT 실시간 STT 스트림(/asr-result) (선택) ───────────────────────
# MQTT_HOST 비면 no-op. finish 이벤트 수신 시 해당 콜 즉시 QA 적재.
MQTT_HOST=
MQTT_PORT=1883
MQTT_PROJ_FILTER=

# 평가항목 공유(서비스 간 조회) 토큰 — 임의 난수 권장.
EVAL_SHARE_TOKEN=
